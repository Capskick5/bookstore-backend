# ============================================================
# BookVerse — Biến môi trường mẫu
# Copy file này thành ".env" rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit .env lên GitHub.
# ============================================================

# ----- PostgreSQL (dùng cho docker-compose + Spring Boot) -----
POSTGRES_DB=bookverse
POSTGRES_USER=bookverse
POSTGRES_PASSWORD=changeme

# ----- Spring Boot -----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bookverse
SPRING_DATASOURCE_USERNAME=bookverse
SPRING_DATASOURCE_PASSWORD=changeme

# JWT — đổi sang chuỗi ngẫu nhiên đủ dài khi triển khai (>= 32 ký tự)
JWT_SECRET=please-change-this-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS — origin của Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Spring Boot gọi sang RAG service nội bộ
RAG_SERVICE_URL=http://localhost:8000

# ----- RAG service (Python, /rag) -----
OPENAI_API_KEY=sk-...replace-me...
QDRANT_URL=http://localhost:6333
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=books_rag
QDRANT_COLLECTION=books
EMBEDDING_DIMENSION=1536
DEFAULT_TOP_K=5
