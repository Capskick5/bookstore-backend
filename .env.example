# ============================================================
# BookVerse — Biến môi trường mẫu
# Copy file này thành ".env" rồi điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit .env lên GitHub.
# ============================================================

# ----- PostgreSQL (dùng cho docker-compose + Spring Boot) -----
POSTGRES_DB=bookverse
POSTGRES_USER=bookverse
POSTGRES_PASSWORD=changeme

# ----- Spring Boot -----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bookverse
SPRING_DATASOURCE_USERNAME=bookverse
SPRING_DATASOURCE_PASSWORD=changeme

# JWT — đổi sang chuỗi ngẫu nhiên đủ dài khi triển khai (>= 32 ký tự)
JWT_SECRET=please-change-this-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS — origin của Frontend (comma-separated nếu nhiều origin)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Spring Boot gọi sang RAG service nội bộ
APP_RAG_BASE_URL=http://localhost:8000
RAG_SERVICE_URL=http://localhost:8000

# ----- Production profile (spring.profiles.active=prod) -----
# Required when deploying: SPRING_DATASOURCE_URL, SPRING_DATASOURCE_USERNAME,
# SPRING_DATASOURCE_PASSWORD, JWT_SECRET, APP_CORS_ALLOWED_ORIGINS,
# APP_PAYMENT_PROVIDER, APP_PAYMENT_MOCK_SIGNING_SECRET, APP_RAG_BASE_URL
# Optional but recommended for cover/avatar upload: CLOUDINARY_CLOUD_NAME,
# CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET

# ----- Cloudinary (book cover + user avatar upload) -----
# Tạo tài khoản miễn phí tại https://cloudinary.com
# Nếu bỏ trống, admin vẫn có thể dán URL ảnh thủ công; upload trả 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ----- SMTP (registration OTP email) -----
# Set MAIL_ENABLED=true and fill values to send real emails. Otherwise OTP is logged in backend console.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=BookVerse <noreply@example.com>

# ----- PayOS (production payment) -----
# Lấy tại https://my.payos.vn — dùng khi APP_PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
APP_PAYMENT_PROVIDER=mock
APP_PAYMENT_MOCK_SIGNING_SECRET=mock-secret
APP_PAYMENT_PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel

# ----- RAG service (Python, /rag) -----
OPENAI_API_KEY=sk-...replace-me...
QDRANT_URL=http://localhost:6333
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=books_rag
QDRANT_COLLECTION=books
EMBEDDING_DIMENSION=1536
DEFAULT_TOP_K=5
